{
  "name": "teamdesk",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check && turbo run typecheck",
    "db:apply": "bun run --filter web db:apply",
    "db:apply:remote": "bun run --filter web db:apply:remote",
    "db:seed": "bun run --filter web db:seed",
    "db:seed:remote": "bun run --filter web db:seed:remote",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "prepare": "husky && turbo run cf-typegen",
    "preview": "turbo run preview",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "husky": "^9.1.7",
    "turbo": "^2.10.11",
    "typescript": "^5.9.2",
    "ultracite": "7.10.5"
  },
  "packageManager": "bun@1.3.11"
}
